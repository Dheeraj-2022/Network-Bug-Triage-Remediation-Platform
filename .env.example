# ==============================================================================
# NetResolve AI — Backend Environment Configuration Example
# Copy to .env (never commit real secrets or credentials).
# ==============================================================================

# --- Core API Security ---
# Optional shared API key for /api/* endpoints (leave empty for localhost dev)
NBT_API_KEY=

# --- Remediation Policy & Execution Mode ---
# simulate (default, safe dry-run) | ansible (live Ansible playbook execution)
NBT_REMEDIATION_MODE=simulate

# Approval expiry window in seconds (default: 3600)
NBT_APPROVAL_TTL_SECONDS=3600

# Live Ansible over Voice Operations (disabled by default; requires NBT_REMEDIATION_MODE=ansible + step-up auth)
NBT_VOICE_ALLOW_ANSIBLE=false

# --- Voice Operations Authentication ---
# Local demo profiles enabled by default when no configured users exist (1 = enabled, 0 = disabled)
NBT_VOICE_DEMO_PROFILES=1
# Production configured voice tokens (disables demo sessions automatically):
# NBT_VOICE_USERS_JSON=[{"token":"replace-me","user_id":"ops-1","display_name":"Alex Mercer","role":"operator","allowed_hosts":["gpu-a","gpu-b"]}]
# NBT_VOICE_USERS_FILE=/path/to/voice_users.json

# --- Google Vertex AI / Gemini Configuration ---
# Set to enable live Vertex AI Gemini reasoning & conversational planning.
# When omitted, NetResolve AI operates transparently in offline deterministic heuristic mode.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional Kafka Telemetry Bus ---
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=telemetry.events
